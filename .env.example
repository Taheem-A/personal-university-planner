# Runtime boundary: development | preview | production | test
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# PostgreSQL (Neon). Runtime may use the pooled endpoint; migrations must use direct.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/database?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/database?sslmode=verify-full
# Neon CLI's standard direct-URL name; Prisma uses it when MIGRATION_DATABASE_URL is absent.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/database?sslmode=verify-full

# Destructive zero-to-current verification. Supply only in an isolated test process.
# The database name must begin with up_m1_migration_ or up_m1_seed_; confirmation must be exact.
MIGRATION_TEST_DATABASE_URL=
CONFIRM_DISPOSABLE_DATABASE=

# Explicit target and confirmation for the deterministic synthetic semester fixture.
# Use only a guarded development/test database; never a production connection.
SEED_DATABASE_URL=
CONFIRM_SYNTHETIC_SEED=

# Repository integration tests. Supply a direct connection to the retained disposable
# Milestone-1 database and the exact confirmation value documented in docs/environments.md.
REPOSITORY_TEST_DATABASE_URL=
CONFIRM_REPOSITORY_TEST_DATABASE=

# Auth.js. Google is the only initial sign-in provider. Required in preview/production.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# Sentry. Optional locally; configured per Vercel environment when monitoring is enabled.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Public canonical URL for callbacks and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
