generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AcademicTermStatus {
  UPCOMING
  ACTIVE
  ARCHIVED
}

enum MeetingType {
  LECTURE
  TUTORIAL
  PRACTICAL
  LAB
  SEMINAR
  OTHER
}

enum AssessmentSubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  GRADED
  EXEMPT
  CANCELLED
}

enum TaskStatus {
  INBOX
  READY
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
  DEFERRED
}

enum TaskDependencyType {
  FINISH_TO_START
}

enum PlanningMode {
  AUTO
  MANUAL
  UNSCHEDULED
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum ConstraintLevel {
  HARD
  SOFT
  INFORMATIONAL
}

enum WorkSessionState {
  PLANNED
  ACTIVE
  COMPLETED
  PARTIAL
  SKIPPED
  CANCELLED
  SUPERSEDED
}

enum WorkSessionGeneratedBy {
  PLANNER
  USER
}

enum CompletionOutcome {
  COMPLETED
  PARTIAL
  SKIPPED
  DONE_EARLY
  CANCELLED
}

enum PlannerRunTrigger {
  MANUAL
  TASK_CREATED
  TASK_UPDATED
  SESSION_COMPLETED
  SESSION_SKIPPED
  CALENDAR_CHANGED
  DEADLINE_CHANGED
  INTEGRATION_SYNC
  DAILY_REFRESH
}

enum PlannerRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum InboxStatus {
  ACTIVE
  PROCESSED
  DISMISSED
}

enum RecordSource {
  MANUAL
  INTEGRATION
  ASSISTANT
  SYSTEM
}

enum SourceAuthority {
  USER
  EXTERNAL
  SYSTEM
  INFERRED
}

enum SourceConfidence {
  DIRECT_API
  CALENDAR_FEED
  DOCUMENT_EXTRACTION
  AI_EXTRACTED
  MANUAL
  USER_CONFIRMED
}

enum IntegrationAccountStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

enum ExternalObjectType {
  COURSE
  ASSESSMENT
  CALENDAR_EVENT
  TASK
}

model User {
  id              String    @id @default(cuid())
  name            String?
  timezone        String
  defaultDayStart DateTime? @db.Time(0)
  defaultDayEnd   DateTime? @db.Time(0)
  locale          String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  academicTerms       AcademicTerm[]
  courses             Course[]
  courseMeetings      CourseMeeting[]
  assessments         Assessment[]
  tasks               Task[]
  taskDependencies    TaskDependency[]
  recurringWorkRules  RecurringWorkRule[]
  calendarEvents      CalendarEvent[]
  availabilityRules   AvailabilityRule[]
  protectedTimeRules  ProtectedTimeRule[]
  planningPreference  PlanningPreference?
  workSessions        WorkSession[]
  completionRecords   CompletionRecord[]
  estimateProfiles    EstimateProfile[]
  plannerRuns         PlannerRun[]
  integrationAccounts IntegrationAccount[]
  externalObjectMaps  ExternalObjectMap[]
  inboxItems          InboxItem[]
  authIdentities      AuthIdentity[]
}

/// Stable sign-in identity only. OAuth credentials for integrations are separate.
model AuthIdentity {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AcademicTerm {
  id        String             @id @default(cuid())
  version   Int                @default(0)
  userId    String
  name      String
  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  status    AcademicTermStatus
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses   Course[]

  @@unique([id, userId])
  @@unique([userId, name])
  @@index([userId, status, startDate, endDate])
}

model Course {
  id                  String              @id @default(cuid())
  version             Int                 @default(0)
  userId              String
  academicTermId      String
  code                String
  name                String
  section             String?
  instructorName      String?
  colorReference      String?
  creditValue         Decimal?            @db.Decimal(5, 2)
  defaultTaskEnergy   EnergyLevel?
  defaultTaskLocation String[]
  source              RecordSource        @default(MANUAL)
  sourceAuthority     SourceAuthority     @default(USER)
  sourceConfidence    SourceConfidence?
  archivedAt          DateTime?           @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicTerm        AcademicTerm        @relation(fields: [academicTermId, userId], references: [id, userId], onDelete: Restrict)
  meetings            CourseMeeting[]
  assessments         Assessment[]
  tasks               Task[]
  recurringWorkRules  RecurringWorkRule[]
  calendarEvents      CalendarEvent[]

  @@unique([id, userId])
  @@unique([userId, academicTermId, code])
  @@index([userId, academicTermId, archivedAt])
  @@index([userId, code])
}

model CourseMeeting {
  id                 String              @id @default(cuid())
  version            Int                 @default(0)
  userId             String
  courseId           String
  meetingType        MeetingType
  recurrenceRule     String
  startTimeLocal     DateTime            @db.Time(0)
  endTimeLocal       DateTime            @db.Time(0)
  spansNextDay       Boolean             @default(false)
  timezone           String
  location           String?
  effectiveFrom      DateTime            @db.Date
  effectiveUntil     DateTime?           @db.Date
  attendanceRequired Boolean             @default(true)
  archivedAt         DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course             Course              @relation(fields: [courseId, userId], references: [id, userId], onDelete: Restrict)
  recurringWorkRules RecurringWorkRule[]

  @@unique([id, userId])
  @@index([userId, courseId, effectiveFrom, effectiveUntil])
}

model Assessment {
  id                    String                     @id @default(cuid())
  version               Int                        @default(0)
  userId                String
  courseId              String
  title                 String
  assessmentType        String
  releaseAt             DateTime?                  @db.Timestamptz(3)
  dueAt                 DateTime?                  @db.Timestamptz(3)
  preferredCompletionAt DateTime?                  @db.Timestamptz(3)
  gradeWeight           Decimal?                   @db.Decimal(5, 2)
  gradeReceived         Decimal?                   @db.Decimal(6, 2)
  notes                 String?
  instructionsUrl       String?
  submissionUrl         String?
  submissionStatus      AssessmentSubmissionStatus @default(NOT_SUBMITTED)
  submittedAt           DateTime?                  @db.Timestamptz(3)
  source                RecordSource               @default(MANUAL)
  sourceAuthority       SourceAuthority            @default(USER)
  sourceConfidence      SourceConfidence?
  archivedAt            DateTime?                  @db.Timestamptz(3)
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @db.Timestamptz(3)
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                Course                     @relation(fields: [courseId, userId], references: [id, userId], onDelete: Restrict)
  tasks                 Task[]

  @@unique([id, userId])
  @@index([userId, courseId, dueAt])
  @@index([userId, submissionStatus, dueAt])
}

model Task {
  id                       String             @id @default(cuid())
  version                  Int                @default(0)
  userId                   String
  courseId                 String?
  assessmentId             String?
  recurringWorkRuleId      String?
  parentTaskId             String?
  title                    String
  description              String?
  status                   TaskStatus
  priorityOverride         Float?
  availableFrom            DateTime?          @db.Timestamptz(3)
  dueAt                    DateTime?          @db.Timestamptz(3)
  preferredCompletionAt    DateTime?          @db.Timestamptz(3)
  originalEstimatedMinutes Int?
  currentEstimatedMinutes  Int?
  remainingMinutes         Int?
  energyRequirement        EnergyLevel?
  locationRequirements     String[]
  minimumSessionMinutes    Int?
  preferredSessionMinutes  Int?
  maximumSessionMinutes    Int?
  splittable               Boolean            @default(true)
  interruptible            Boolean            @default(true)
  planningMode             PlanningMode       @default(AUTO)
  source                   RecordSource       @default(MANUAL)
  sourceAuthority          SourceAuthority    @default(USER)
  sourceConfidence         SourceConfidence?
  completedAt              DateTime?          @db.Timestamptz(3)
  archivedAt               DateTime?          @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @db.Timestamptz(3)
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                   Course?            @relation(fields: [courseId, userId], references: [id, userId], onDelete: Restrict)
  assessment               Assessment?        @relation(fields: [assessmentId, userId], references: [id, userId], onDelete: Restrict)
  recurringWorkRule        RecurringWorkRule? @relation(fields: [recurringWorkRuleId, userId], references: [id, userId], onDelete: Restrict)
  parentTask               Task?              @relation("TaskHierarchy", fields: [parentTaskId, userId], references: [id, userId], onDelete: Restrict)
  subtasks                 Task[]             @relation("TaskHierarchy")
  prerequisiteLinks        TaskDependency[]   @relation("DependencyPrerequisite")
  dependentLinks           TaskDependency[]   @relation("DependencyDependent")
  workSessions             WorkSession[]
  completionRecords        CompletionRecord[]

  @@unique([id, userId])
  @@index([userId, status, dueAt])
  @@index([userId, assessmentId])
  @@index([userId, parentTaskId])
  @@index([userId, recurringWorkRuleId])
}

model TaskDependency {
  userId             String
  prerequisiteTaskId String
  dependentTaskId    String
  dependencyType     TaskDependencyType @default(FINISH_TO_START)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  prerequisiteTask   Task               @relation("DependencyPrerequisite", fields: [prerequisiteTaskId, userId], references: [id, userId], onDelete: Cascade)
  dependentTask      Task               @relation("DependencyDependent", fields: [dependentTaskId, userId], references: [id, userId], onDelete: Cascade)

  @@id([userId, prerequisiteTaskId, dependentTaskId])
  @@index([userId, dependentTaskId])
}

model RecurringWorkRule {
  id                       String         @id @default(cuid())
  userId                   String
  courseId                 String
  anchorCourseMeetingId    String?
  titleTemplate            String
  descriptionTemplate      String?
  recurrenceRule           String
  anchorTimeLocal          DateTime       @db.Time(0)
  timezone                 String
  effectiveFrom            DateTime       @db.Date
  effectiveUntil           DateTime?      @db.Date
  availableOffsetMinutes   Int            @default(0)
  dueOffsetMinutes         Int?
  originalEstimatedMinutes Int?
  energyRequirement        EnergyLevel?
  locationRequirements     String[]
  minimumSessionMinutes    Int?
  preferredSessionMinutes  Int?
  maximumSessionMinutes    Int?
  splittable               Boolean        @default(true)
  interruptible            Boolean        @default(true)
  planningMode             PlanningMode   @default(AUTO)
  active                   Boolean        @default(true)
  createdAt                DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(3)
  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                   Course         @relation(fields: [courseId, userId], references: [id, userId], onDelete: Restrict)
  anchorCourseMeeting      CourseMeeting? @relation(fields: [anchorCourseMeetingId, userId], references: [id, userId], onDelete: Restrict)
  generatedTasks           Task[]

  @@unique([id, userId])
  @@index([userId, courseId, active, effectiveFrom, effectiveUntil])
}

model CalendarEvent {
  id                   String              @id @default(cuid())
  version              Int                 @default(0)
  userId               String
  courseId             String?
  integrationAccountId String?
  title                String
  eventType            String
  startAt              DateTime            @db.Timestamptz(3)
  endAt                DateTime            @db.Timestamptz(3)
  location             String?
  constraintLevel      ConstraintLevel
  source               RecordSource        @default(MANUAL)
  sourceAuthority      SourceAuthority     @default(USER)
  sourceConfidence     SourceConfidence?
  externalId           String?
  externalUpdatedAt    DateTime?           @db.Timestamptz(3)
  archivedAt           DateTime?           @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               Course?             @relation(fields: [courseId, userId], references: [id, userId], onDelete: Restrict)
  integrationAccount   IntegrationAccount? @relation(fields: [integrationAccountId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([integrationAccountId, externalId])
  @@index([userId, startAt, endAt])
  @@index([userId, courseId, startAt])
}

model AvailabilityRule {
  id                  String      @id @default(cuid())
  version             Int         @default(0)
  userId              String
  recurrenceRule      String
  startTimeLocal      DateTime    @db.Time(0)
  endTimeLocal        DateTime    @db.Time(0)
  spansNextDay        Boolean     @default(false)
  timezone            String
  capacityFactor      Float       @default(1)
  energyLevel         EnergyLevel
  allowedLocationTags String[]
  effectiveFrom       DateTime    @db.Date
  effectiveUntil      DateTime?   @db.Date
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active, effectiveFrom, effectiveUntil])
}

model ProtectedTimeRule {
  id              String          @id @default(cuid())
  version         Int             @default(0)
  userId          String
  recurrenceRule  String
  startTimeLocal  DateTime        @db.Time(0)
  endTimeLocal    DateTime        @db.Time(0)
  spansNextDay    Boolean         @default(false)
  timezone        String
  protectionLevel ConstraintLevel
  reason          String
  effectiveFrom   DateTime        @db.Date
  effectiveUntil  DateTime?       @db.Date
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active, effectiveFrom, effectiveUntil])
}

model PlanningPreference {
  id                              String   @id @default(cuid())
  version                         Int      @default(0)
  userId                          String   @unique
  preferredDailyStudyLimitMinutes Int
  minimumFreeTimeMinutes          Int
  preferredDeadlineBufferHours    Int
  avoidLateHighEnergyTasks        Boolean
  maximumConsecutiveWorkMinutes   Int
  minimumBreakMinutes             Int
  scheduleCommuteWork             Boolean
  weekendWorkBias                 Float
  planStabilityWindowMinutes      Int
  createdAt                       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime @updatedAt @db.Timestamptz(3)
  user                            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkSession {
  id                String                 @id @default(cuid())
  version           Int                    @default(0)
  userId            String
  taskId            String
  plannerRunId      String?
  startAt           DateTime               @db.Timestamptz(3)
  endAt             DateTime               @db.Timestamptz(3)
  plannedMinutes    Int
  state             WorkSessionState
  generatedBy       WorkSessionGeneratedBy
  locked            Boolean                @default(false)
  supersededById    String?
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  task              Task                   @relation(fields: [taskId, userId], references: [id, userId], onDelete: Restrict)
  plannerRun        PlannerRun?            @relation(fields: [plannerRunId, userId], references: [id, userId], onDelete: Restrict)
  supersededBy      WorkSession?           @relation("SessionSupersession", fields: [supersededById, userId], references: [id, userId], onDelete: Restrict)
  supersedes        WorkSession?           @relation("SessionSupersession")
  completionRecords CompletionRecord[]

  @@unique([id, userId])
  @@unique([supersededById, userId])
  @@index([userId, startAt, endAt])
  @@index([userId, taskId, state])
  @@index([userId, plannerRunId])
}

model CompletionRecord {
  id                    String            @id @default(cuid())
  userId                String
  taskId                String
  workSessionId         String?
  outcome               CompletionOutcome
  actualMinutes         Int?
  remainingAfterMinutes Int?
  recordedAt            DateTime          @default(now()) @db.Timestamptz(3)
  note                  String?
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  task                  Task              @relation(fields: [taskId, userId], references: [id, userId], onDelete: Restrict)
  workSession           WorkSession?      @relation(fields: [workSessionId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId, taskId, recordedAt])
  @@index([userId, workSessionId])
}

model EstimateProfile {
  id           String   @id @default(cuid())
  userId       String
  contextType  String
  contextKey   String
  sampleCount  Int      @default(0)
  meanRatio    Float?
  medianRatio  Float?
  recentRatio  Float?
  confidence   Float    @default(0)
  modelVersion String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contextType, contextKey])
  @@index([userId, updatedAt])
}

model PlannerRun {
  id                   String            @id @default(cuid())
  userId               String
  startedAt            DateTime          @default(now()) @db.Timestamptz(3)
  completedAt          DateTime?         @db.Timestamptz(3)
  triggerType          PlannerRunTrigger
  triggerEntityType    String?
  triggerEntityId      String?
  planningHorizonStart DateTime          @db.Timestamptz(3)
  planningHorizonEnd   DateTime          @db.Timestamptz(3)
  plannerVersion       String
  inputSnapshot        Json
  summary              Json?
  warnings             Json?
  status               PlannerRunStatus
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workSessions         WorkSession[]

  @@unique([id, userId])
  @@index([userId, startedAt])
  @@index([userId, triggerType, startedAt])
}

model IntegrationAccount {
  id                  String                   @id @default(cuid())
  version             Int                      @default(0)
  userId              String
  provider            String
  externalAccountId   String
  displayName         String?
  status              IntegrationAccountStatus
  credentialReference String?
  lastSyncAt          DateTime?                @db.Timestamptz(3)
  lastSuccessAt       DateTime?                @db.Timestamptz(3)
  disconnectedAt      DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalObjectMaps  ExternalObjectMap[]
  calendarEvents      CalendarEvent[]

  @@unique([id, userId])
  @@unique([id, userId, provider])
  @@unique([userId, provider, externalAccountId])
  @@index([userId, provider, status])
}

model ExternalObjectMap {
  id                   String             @id @default(cuid())
  userId               String
  integrationAccountId String
  provider             String
  externalId           String
  internalType         ExternalObjectType
  internalId           String
  externalUpdatedAt    DateTime?          @db.Timestamptz(3)
  lastSyncedAt         DateTime?          @db.Timestamptz(3)
  sourceHash           String?
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationAccount   IntegrationAccount @relation(fields: [integrationAccountId, userId, provider], references: [id, userId, provider], onDelete: Restrict)

  @@unique([integrationAccountId, externalId])
  @@unique([userId, provider, externalId])
  @@unique([userId, internalType, internalId, integrationAccountId])
  @@index([userId, internalType, internalId])
}

model InboxItem {
  id                 String            @id @default(cuid())
  version            Int               @default(0)
  userId             String
  rawText            String
  source             RecordSource      @default(MANUAL)
  sourceAuthority    SourceAuthority   @default(USER)
  sourceConfidence   SourceConfidence?
  status             InboxStatus       @default(ACTIVE)
  proposedEntityType String?
  proposedPayload    Json?
  processedAt        DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}
