generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AcademicTermStatus {
  UPCOMING
  ACTIVE
  ARCHIVED
}

enum MeetingType {
  LECTURE
  TUTORIAL
  PRACTICAL
  LAB
  SEMINAR
  OTHER
}

enum AssessmentStatus {
  UPCOMING
  AVAILABLE
  IN_PROGRESS
  SUBMITTED
  GRADED
  CANCELLED
}

enum TaskStatus {
  INBOX
  READY
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
  DEFERRED
}

enum PlanningMode {
  AUTO
  MANUAL
  UNSCHEDULED
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum ConstraintLevel {
  HARD
  SOFT
  INFORMATIONAL
}

enum WorkSessionState {
  PLANNED
  ACTIVE
  COMPLETED
  PARTIAL
  SKIPPED
  CANCELLED
  SUPERSEDED
}

enum WorkSessionGeneratedBy {
  PLANNER
  USER
}

enum CompletionOutcome {
  COMPLETED
  PARTIAL
  SKIPPED
  DONE_EARLY
  CANCELLED
}

enum PlannerRunTrigger {
  MANUAL
  TASK_CREATED
  TASK_UPDATED
  SESSION_COMPLETED
  SESSION_SKIPPED
  CALENDAR_CHANGED
  DEADLINE_CHANGED
  INTEGRATION_SYNC
  DAILY_REFRESH
}

enum PlannerRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum InboxStatus {
  ACTIVE
  PROCESSED
  DISMISSED
}

model User {
  id             String   @id @default(cuid())
  name           String
  timezone       String
  defaultDayStart String?
  defaultDayEnd   String?
  locale         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicTerms       AcademicTerm[]
  courses             Course[]
  tasks               Task[]
  calendarEvents      CalendarEvent[]
  availabilityRules   AvailabilityRule[]
  protectedTimeRules  ProtectedTimeRule[]
  planningPreferences PlanningPreference[]
  workSessions        WorkSession[]
  estimateProfiles    EstimateProfile[]
  plannerRuns         PlannerRun[]
  externalObjectMaps  ExternalObjectMap[]
  inboxItems          InboxItem[]
  integrationAccounts IntegrationAccount[]
}

model AcademicTerm {
  id        String             @id @default(cuid())
  userId    String
  name      String
  startDate DateTime
  endDate   DateTime
  status    AcademicTermStatus
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  @@index([userId, status])
}

model Course {
  id                  String   @id @default(cuid())
  userId              String
  academicTermId      String
  code                String
  name                String
  section             String?
  instructorName      String?
  colorReference      String?
  creditValue         Float?
  defaultTaskEnergy   EnergyLevel?
  defaultTaskLocation String[]
  archived            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicTerm  AcademicTerm  @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  meetings      CourseMeeting[]
  assessments   Assessment[]
  tasks         Task[]
  calendarEvents CalendarEvent[]

  @@index([userId, academicTermId, archived])
  @@index([academicTermId, code])
}

model CourseMeeting {
  id                 String      @id @default(cuid())
  courseId           String
  meetingType        MeetingType
  recurrenceRule     String
  startTimeLocal     String
  endTimeLocal       String
  timezone           String
  location           String?
  startDate          DateTime
  endDate            DateTime
  attendanceRequired Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, startDate, endDate])
}

model Assessment {
  id                    String           @id @default(cuid())
  courseId              String
  title                 String
  assessmentType        String
  releaseAt             DateTime?
  dueAt                 DateTime?
  preferredCompletionAt DateTime?
  gradeWeight           Float?
  instructionsUrl       String?
  submissionUrl         String?
  status                AssessmentStatus
  source                String?
  sourceConfidence      String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@index([courseId, dueAt])
}

model Task {
  id                    String       @id @default(cuid())
  userId                String
  courseId              String?
  assessmentId          String?
  parentTaskId          String?
  title                 String
  description           String?
  status                TaskStatus
  priorityOverride      Float?
  availableFrom         DateTime?
  dueAt                 DateTime?
  preferredCompletionAt DateTime?
  originalEstimatedMinutes Int?
  estimatedMinutes      Int?
  remainingMinutes      Int?
  energyRequirement     EnergyLevel?
  locationRequirements  String[]
  minimumSessionMinutes Int?
  preferredSessionMinutes Int?
  maximumSessionMinutes Int?
  splittable            Boolean      @default(true)
  interruptible         Boolean      @default(true)
  planningMode          PlanningMode @default(AUTO)
  source                String?
  completedAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  assessment  Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  parentTask  Task?       @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks    Task[]      @relation("TaskHierarchy")
  prerequisiteLinks TaskDependency[] @relation("DependencyPrerequisite")
  dependentLinks    TaskDependency[] @relation("DependencyDependent")
  workSessions      WorkSession[]
  completionRecords CompletionRecord[]

  @@index([userId, status, dueAt])
  @@index([assessmentId])
}

model TaskDependency {
  prerequisiteTaskId String
  dependentTaskId    String
  dependencyType     String @default("FINISH_TO_START")

  prerequisiteTask Task @relation("DependencyPrerequisite", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)
  dependentTask    Task @relation("DependencyDependent", fields: [dependentTaskId], references: [id], onDelete: Cascade)

  @@id([prerequisiteTaskId, dependentTaskId])
}

model CalendarEvent {
  id                String          @id @default(cuid())
  userId            String
  courseId          String?
  title             String
  eventType         String
  startAt           DateTime
  endAt             DateTime
  location          String?
  source            String?
  constraintLevel   ConstraintLevel
  externalProvider  String?
  externalId        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, startAt, endAt])
  @@index([externalProvider, externalId])
}

model AvailabilityRule {
  id                  String      @id @default(cuid())
  userId              String
  recurrenceRule      String
  startTimeLocal      String
  endTimeLocal        String
  timezone             String
  capacityFactor      Float       @default(1)
  energyLevel         EnergyLevel
  allowedLocationTags String[]
  effectiveFrom       DateTime?
  effectiveUntil      DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom, effectiveUntil])
}

model ProtectedTimeRule {
  id              String   @id @default(cuid())
  userId          String
  recurrenceRule  String
  startTimeLocal  String
  endTimeLocal    String
  timezone        String
  protectionLevel ConstraintLevel
  reason          String
  effectiveFrom   DateTime?
  effectiveUntil  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom, effectiveUntil])
}

model PlanningPreference {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model WorkSession {
  id             String               @id @default(cuid())
  userId         String
  taskId         String
  plannerRunId   String?
  startAt        DateTime
  endAt          DateTime
  plannedMinutes Int
  state          WorkSessionState
  generatedBy    WorkSessionGeneratedBy
  locked         Boolean              @default(false)
  supersededById String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  plannerRun    PlannerRun?  @relation(fields: [plannerRunId], references: [id], onDelete: SetNull)
  supersededBy  WorkSession? @relation("SessionSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes    WorkSession[] @relation("SessionSupersession")
  completionRecords CompletionRecord[]

  @@index([userId, startAt, endAt])
  @@index([taskId, state])
}

model CompletionRecord {
  id                       String            @id @default(cuid())
  taskId                   String
  workSessionId            String?
  outcome                  CompletionOutcome
  actualMinutes            Int?
  completedMinutesEstimate Int?
  recordedAt               DateTime          @default(now())
  note                     String?

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workSession WorkSession? @relation(fields: [workSessionId], references: [id], onDelete: SetNull)

  @@index([taskId, recordedAt])
}

model EstimateProfile {
  id          String   @id @default(cuid())
  userId      String
  contextType String
  contextId   String?
  sampleCount Int      @default(0)
  meanRatio   Float?
  medianRatio Float?
  recentRatio Float?
  confidence  Float    @default(0)
  modelVersion String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, contextType, contextId])
}

model PlannerRun {
  id                   String            @id @default(cuid())
  userId               String
  startedAt            DateTime          @default(now())
  completedAt          DateTime?
  triggerType          PlannerRunTrigger
  planningHorizonStart DateTime
  planningHorizonEnd   DateTime
  plannerVersion       String
  inputSnapshot        Json
  summary              Json?
  warnings             Json?
  status                PlannerRunStatus

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workSessions WorkSession[]

  @@index([userId, startedAt])
}

model ExternalObjectMap {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  externalId        String
  internalType      String
  internalId        String
  externalUpdatedAt DateTime?
  lastSyncedAt      DateTime?
  sourceHash        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId, internalType, internalId])
}

model InboxItem {
  id                 String      @id @default(cuid())
  userId             String
  rawText            String
  source             String?
  status             InboxStatus @default(ACTIVE)
  proposedEntityType String?
  proposedPayload    Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model IntegrationAccount {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  status          String
  encryptedTokens String?
  lastSyncAt      DateTime?
  lastSuccessAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}
